# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/managed-marketplace

# JWT Auth Secrets
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS and Clients
CLIENT_URL=http://localhost:5173

# Marketplace Commission Rate
MARKETPLACE_COMMISSION_RATE=0.10

# Payment Integrations (Chapa Test / Live)
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
CHAPA_WEBHOOK_SECRET=

# Google OAuth (Google Identity Services)
GOOGLE_CLIENT_ID=

# Image Storage Config
IMAGE_STORAGE_PROVIDER=local
IMAGE_STORAGE_URL=http://localhost:5000/uploads

